@model MediStock.Web.Models.InventoryListViewModel<MediStock.Application.Dtos.BatchListItemDto>
@{
    ViewData["Title"] = "Batches";
    ViewData["Page"] = Model.Page.Page;
    ViewData["TotalPages"] = Model.Page.TotalPages;
    ViewData["TotalCount"] = Model.Page.TotalCount;
    ViewData["Search"] = Model.Search;
    ViewData["Sort"] = Model.Sort;
    ViewData["Descending"] = Model.Descending;
    ViewData["DrugIdFilter"] = Model.DrugIdFilter;

    string SortLink(string field)
    {
        var nextDesc = Model.Sort == field && !Model.Descending;
        return Url.Action("Index", new { search = Model.Search, sort = field, desc = nextDesc, page = 1, drugId = Model.DrugIdFilter })!;
    }

    string ExpiryClass(MediStock.Application.Dtos.BatchListItemDto b)
    {
        if (b.IsExpired || !b.IsActive) return "bg-secondary-subtle text-secondary";
        if (b.DaysUntilExpiry < 30) return "bg-danger-subtle text-danger";
        if (b.DaysUntilExpiry < 90) return "bg-warning-subtle text-warning";
        return "bg-success-subtle text-success";
    }
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Batches</h1>
    <a class="btn btn-primary" asp-action="Create">+ Stock-in (new batch)</a>
</div>

<partial name="_Toasts" />

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Search by batch #, drug, or supplier…" />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary" type="submit">Search</button>
        @if (!string.IsNullOrEmpty(Model.Search))
        {
            <a class="btn btn-link" asp-action="Index">Clear</a>
        }
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th><a href="@SortLink("drug")" class="text-dark text-decoration-none">Drug @(Model.Sort == "drug" ? (Model.Descending ? "↓" : "↑") : "")</a></th>
                    <th>Batch #</th>
                    <th>Supplier</th>
                    <th class="text-end">Qty in</th>
                    <th class="text-end">Remaining</th>
                    <th class="text-end">Sell price</th>
                    <th><a href="@SortLink("expiry")" class="text-dark text-decoration-none">Expiry @(Model.Sort == "expiry" ? (Model.Descending ? "↓" : "↑") : "")</a></th>
                    <th><a href="@SortLink("received")" class="text-dark text-decoration-none">Received</a></th>
                    <th class="text-end" style="width:80px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model.Page.Items)
                {
                    <tr>
                        <td><a asp-controller="Drugs" asp-action="Details" asp-route-id="@b.DrugId">@b.DrugName</a></td>
                        <td>@b.BatchNumber</td>
                        <td>@b.SupplierName</td>
                        <td class="text-end">@b.QuantityIn</td>
                        <td class="text-end">@b.QuantityRemaining</td>
                        <td class="text-end">@b.SellPrice.ToString("N0")</td>
                        <td><span class="badge @ExpiryClass(b)">@b.ExpiryDate.ToString("yyyy-MM-dd") (@b.DaysUntilExpiry d)</span></td>
                        <td class="text-muted">@b.ReceivedAt.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@b.Id">View</a>
                        </td>
                    </tr>
                }
                @if (!Model.Page.Items.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">No batches yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pager" />
