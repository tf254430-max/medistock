@model MediStock.Application.Dtos.CategoryCreateDto
@{
    ViewData["Title"] = "New category";
}

<h1 class="h4 mb-3">New category</h1>

<form method="post" asp-action="Create" class="card shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Name</label>
            <input asp-for="Name" class="form-control" autofocus />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
    </div>
    <div class="card-footer text-end">
        <a class="btn btn-link" asp-action="Index">Cancel</a>
        <button type="submit" class="btn btn-primary">Create</button>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
