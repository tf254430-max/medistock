@model MediStock.Application.Dtos.CustomerCreateDto
@{ ViewData["Title"] = "New customer"; }

<h1 class="h4 mb-3">New customer</h1>

<form method="post" asp-action="Create" class="card shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="FullName" class="form-label">Full name</label>
                <input asp-for="FullName" class="form-control" autofocus />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Phone" class="form-label">Phone</label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="NIN" class="form-label">NIN</label>
                <input asp-for="NIN" class="form-control" />
                <span asp-validation-for="NIN" class="text-danger"></span>
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <div class="form-check">
                    <input class="form-check-input" asp-for="IsRecurring" />
                    <label class="form-check-label" asp-for="IsRecurring">Recurring customer</label>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer text-end">
        <a class="btn btn-link" asp-action="Index">Cancel</a>
        <button type="submit" class="btn btn-primary">Create</button>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
