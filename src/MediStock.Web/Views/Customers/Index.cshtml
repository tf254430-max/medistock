@model MediStock.Web.Models.InventoryListViewModel<MediStock.Application.Dtos.CustomerListItemDto>
@{
    ViewData["Title"] = "Customers";
    ViewData["Page"] = Model.Page.Page;
    ViewData["TotalPages"] = Model.Page.TotalPages;
    ViewData["TotalCount"] = Model.Page.TotalCount;
    ViewData["Search"] = Model.Search;
    ViewData["Sort"] = Model.Sort;
    ViewData["Descending"] = Model.Descending;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Customers</h1>
    <a class="btn btn-primary" asp-action="Create">+ New customer</a>
</div>

<partial name="_Toasts" />

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Search by name, phone, or NIN…" />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary" type="submit">Search</button>
        @if (!string.IsNullOrEmpty(Model.Search))
        {
            <a class="btn btn-link" asp-action="Index">Clear</a>
        }
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>NIN</th>
                    <th>Recurring</th>
                    <th class="text-end">Prescriptions</th>
                    <th class="text-end">Sales</th>
                    <th class="text-end" style="width:160px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Page.Items)
                {
                    <tr>
                        <td>@c.FullName</td>
                        <td>@(c.Phone ?? "—")</td>
                        <td>@(c.NIN ?? "—")</td>
                        <td>
                            @if (c.IsRecurring) { <span class="badge bg-info-subtle text-info">Recurring</span> }
                        </td>
                        <td class="text-end">@c.PrescriptionCount</td>
                        <td class="text-end">@c.SaleCount</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@c.Id">View</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id">Edit</a>
                        </td>
                    </tr>
                }
                @if (!Model.Page.Items.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No customers yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pager" />
