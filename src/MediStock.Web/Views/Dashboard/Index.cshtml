@model MediStock.Web.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h1 class="card-title h3">Welcome, @Model.FullName</h1>
            <p class="text-muted mb-2">@Model.Email</p>
            <p class="mb-3">
                You are signed in as
                @if (Model.Roles.Any())
                {
                    @:<strong>@string.Join(", ", Model.Roles)</strong>.
                }
                else
                {
                    @:a user (no roles assigned).
                }
            </p>
            <p class="text-muted small mb-0">
                MediStock — Pharmacy Inventory, Prescription, and Sales Management.
            </p>
        </div>
    </div>

    <div class="mt-3">
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
            <button type="submit" class="btn btn-outline-secondary">Sign out</button>
        </form>
    </div>
</div>
