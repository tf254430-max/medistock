@model MediStock.Web.Models.InventoryListViewModel<MediStock.Application.Dtos.DrugListItemDto>
@{
    ViewData["Title"] = "Drugs";
    ViewData["Page"] = Model.Page.Page;
    ViewData["TotalPages"] = Model.Page.TotalPages;
    ViewData["TotalCount"] = Model.Page.TotalCount;
    ViewData["Search"] = Model.Search;
    ViewData["Sort"] = Model.Sort;
    ViewData["Descending"] = Model.Descending;

    string SortLink(string field)
    {
        var nextDesc = Model.Sort == field && !Model.Descending;
        return Url.Action("Index", new { search = Model.Search, sort = field, desc = nextDesc, page = 1 })!;
    }

    string StockClass(MediStock.Application.Dtos.DrugListItemDto d)
    {
        if (d.CurrentStock == 0) return "bg-danger-subtle text-danger fw-semibold";
        if (d.CurrentStock <= d.ReorderLevel) return "bg-warning-subtle text-warning fw-semibold";
        return "";
    }
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Drugs</h1>
    <a class="btn btn-primary" asp-action="Create">+ New drug</a>
</div>

<partial name="_Toasts" />

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Search by name, generic name, NDA, or barcode…" />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary" type="submit">Search</button>
        @if (!string.IsNullOrEmpty(Model.Search))
        {
            <a class="btn btn-link" asp-action="Index">Clear</a>
        }
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th><a href="@SortLink("name")" class="text-dark text-decoration-none">Name @(Model.Sort == "name" ? (Model.Descending ? "↓" : "↑") : "")</a></th>
                    <th><a href="@SortLink("category")" class="text-dark text-decoration-none">Category</a></th>
                    <th>Form</th>
                    <th>Strength</th>
                    <th class="text-end">Stock</th>
                    <th class="text-end"><a href="@SortLink("reorder")" class="text-dark text-decoration-none">Reorder level</a></th>
                    <th>Status</th>
                    <th class="text-end" style="width:160px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Page.Items)
                {
                    <tr>
                        <td>
                            <div>@d.Name</div>
                            @if (!string.IsNullOrEmpty(d.GenericName))
                            { <small class="text-muted">@d.GenericName</small> }
                            @if (d.RequiresPrescription)
                            { <span class="badge bg-info-subtle text-info ms-1">Rx</span> }
                        </td>
                        <td>@d.CategoryName</td>
                        <td>@d.Form</td>
                        <td>@d.Strength</td>
                        <td class="text-end @StockClass(d)">@d.CurrentStock</td>
                        <td class="text-end text-muted">@d.ReorderLevel</td>
                        <td>
                            @if (d.IsActive)
                            { <span class="badge bg-success-subtle text-success">Active</span> }
                            else
                            { <span class="badge bg-secondary-subtle text-secondary">Inactive</span> }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@d.Id">View</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@d.Id">Edit</a>
                        </td>
                    </tr>
                }
                @if (!Model.Page.Items.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No drugs yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pager" />
