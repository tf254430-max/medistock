@model MediStock.Application.Dtos.SalesReportSummary
@{
    ViewData["Title"] = "Sales report";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Sales report</h1>
    <div>
        <a class="btn btn-outline-success btn-sm" asp-action="SalesCsv" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")">Export CSV</a>
        <a class="btn btn-primary btn-sm" asp-action="SalesPdf" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" target="_blank">Export PDF</a>
    </div>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <label class="form-label small">From</label>
        <input type="date" name="from" class="form-control form-control-sm" value="@Model.From.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-auto">
        <label class="form-label small">To</label>
        <input type="date" name="to" class="form-control form-control-sm" value="@Model.To.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-auto d-flex align-items-end">
        <button class="btn btn-outline-secondary btn-sm" type="submit">Apply</button>
    </div>
</form>

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card shadow-sm"><div class="card-body">
        <div class="text-muted small">Transactions</div>
        <div class="h4 mb-0">@Model.TransactionCount.ToString("N0")</div>
    </div></div></div>
    <div class="col-md-3"><div class="card shadow-sm"><div class="card-body">
        <div class="text-muted small">Subtotal (UGX)</div>
        <div class="h4 mb-0">@Model.SubTotal.ToString("N0")</div>
    </div></div></div>
    <div class="col-md-3"><div class="card shadow-sm"><div class="card-body">
        <div class="text-muted small">VAT (UGX)</div>
        <div class="h4 mb-0">@Model.Vat.ToString("N0")</div>
    </div></div></div>
    <div class="col-md-3"><div class="card shadow-sm bg-success-subtle"><div class="card-body">
        <div class="text-muted small">Total revenue (UGX)</div>
        <div class="h4 mb-0 text-success">@Model.Total.ToString("N0")</div>
    </div></div></div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Receipt</th>
                    <th>Date</th>
                    <th>Cashier</th>
                    <th>Customer</th>
                    <th>Pay</th>
                    <th class="text-end">Items</th>
                    <th class="text-end">Total (UGX)</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr class="@(r.IsVoided ? "text-muted" : "")">
                        <td>@r.ReceiptNumber</td>
                        <td>@r.CompletedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@r.CashierName</td>
                        <td>@(r.CustomerName ?? "Walk-in")</td>
                        <td>@r.PaymentMethod</td>
                        <td class="text-end">@r.Items</td>
                        <td class="text-end @(r.IsVoided ? "text-decoration-line-through" : "")">@r.Total.ToString("N0")</td>
                        <td>
                            @if (r.IsVoided) { <span class="badge bg-danger-subtle text-danger">Voided</span> }
                            else { <span class="badge bg-success-subtle text-success">OK</span> }
                        </td>
                    </tr>
                }
                @if (!Model.Rows.Any())
                { <tr><td colspan="8" class="text-center text-muted py-3">No sales in this date range.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
