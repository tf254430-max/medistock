@model MediStock.Web.Models.SettingsViewModel
@{ ViewData["Title"] = "Settings"; }

<h1 class="h3 mb-3">Pharmacy settings</h1>

<partial name="_Toasts" />

<form method="post" asp-action="Index" class="card shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="PharmacyName" class="form-label"></label>
                <input asp-for="PharmacyName" class="form-control" />
                <span asp-validation-for="PharmacyName" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="PharmacyPhone" class="form-label"></label>
                <input asp-for="PharmacyPhone" class="form-control" />
            </div>
            <div class="col-md-12">
                <label asp-for="PharmacyAddress" class="form-label"></label>
                <input asp-for="PharmacyAddress" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="Currency" class="form-label"></label>
                <input asp-for="Currency" class="form-control" />
                <span asp-validation-for="Currency" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="VatRate" class="form-label"></label>
                <input asp-for="VatRate" class="form-control" type="number" step="0.001" min="0" max="1" />
                <small class="form-text text-muted">@(Model.VatRate * 100m)% applied to future sales.</small>
                <span asp-validation-for="VatRate" class="text-danger"></span>
            </div>
        </div>

        <div class="alert alert-info mt-3 mb-0 small">
            Changing the VAT rate affects future sales only. Past sales remain at the rate captured at sale time.
        </div>
    </div>
    <div class="card-footer text-end">
        <button type="submit" class="btn btn-primary">Save settings</button>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
