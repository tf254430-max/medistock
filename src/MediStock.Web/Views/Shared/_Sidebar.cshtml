@using Microsoft.AspNetCore.Identity
@using MediStock.Application.Interfaces
@using MediStock.Domain.Entities
@inject SignInManager<AppUser> SignInManager
@inject IInventoryAlertService Alerts

@{
    var alertSummary = await Alerts.GetSummaryAsync(Context.RequestAborted);
    bool isAdmin = User.IsInRole("Admin");
    bool isPharmacist = User.IsInRole("Pharmacist");
    bool isCashier = User.IsInRole("Cashier");
    bool canSee(string area) => area switch
    {
        "inventory" => isAdmin || isPharmacist,
        "till" => isAdmin || isCashier,
        "prescriptions" => isAdmin || isPharmacist,
        "customers" => true,
        "reports" => isAdmin,
        "users" => isAdmin,
        "audit" => isAdmin,
        "settings" => isAdmin,
        _ => true
    };

    string CurrentClass(string controller) =>
        string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), controller, StringComparison.OrdinalIgnoreCase)
            ? "active fw-semibold" : "";
}

@if (SignInManager.IsSignedIn(User))
{
    <aside class="medistock-sidebar bg-body-tertiary border-end p-3">
        <ul class="nav nav-pills flex-column">
            <li class="nav-item">
                <a class="nav-link @CurrentClass("Dashboard") text-body" asp-controller="Dashboard" asp-action="Index">
                    <span class="me-2">⌂</span> Dashboard
                </a>
            </li>

            @if (canSee("till"))
            {
                <li class="nav-item">
                    <a class="nav-link @CurrentClass("Sales") text-body" asp-controller="Sales" asp-action="Till">
                        <span class="me-2">$</span> Till (POS)
                    </a>
                    @if (isAdmin)
                    {
                        <a class="nav-link text-body ps-4 small" asp-controller="Sales" asp-action="Index">
                            All sales
                        </a>
                    }
                </li>
            }

            @if (canSee("inventory"))
            {
                <li class="nav-item mt-2">
                    <div class="text-uppercase text-muted small px-3 mb-1 d-flex justify-content-between align-items-center">
                        <span>Inventory</span>
                        @if (alertSummary.Total > 0)
                        {
                            <span class="badge bg-danger" title="@alertSummary.LowStockCount low-stock, @alertSummary.ExpiringSoonCount expiring soon">
                                @alertSummary.Total
                            </span>
                        }
                    </div>
                    <a class="nav-link @CurrentClass("Drugs") text-body" asp-controller="Drugs" asp-action="Index">
                        <span class="me-2">℞</span> Drugs
                    </a>
                    <a class="nav-link @CurrentClass("Categories") text-body" asp-controller="Categories" asp-action="Index">
                        <span class="me-2">▦</span> Categories
                    </a>
                    <a class="nav-link @CurrentClass("Suppliers") text-body" asp-controller="Suppliers" asp-action="Index">
                        <span class="me-2">⚯</span> Suppliers
                    </a>
                    <a class="nav-link @CurrentClass("Batches") text-body" asp-controller="Batches" asp-action="Index">
                        <span class="me-2">▤</span> Batches
                    </a>
                </li>
            }

            @if (canSee("prescriptions"))
            {
                <li class="nav-item mt-2">
                    <a class="nav-link @CurrentClass("Prescriptions") text-body" asp-controller="Prescriptions" asp-action="Index">
                        <span class="me-2">⊳</span> Prescriptions
                    </a>
                </li>
            }

            @if (canSee("customers"))
            {
                <li class="nav-item">
                    <a class="nav-link @CurrentClass("Customers") text-body" asp-controller="Customers" asp-action="Index">
                        <span class="me-2">☺</span> Customers
                    </a>
                </li>
            }

            @if (canSee("reports"))
            {
                <li class="nav-item">
                    <a class="nav-link @CurrentClass("Reports") text-body" asp-controller="Reports" asp-action="Index">
                        <span class="me-2">⌬</span> Reports
                    </a>
                </li>
            }

            @if (isAdmin)
            {
                <li class="nav-item mt-2">
                    <div class="text-uppercase text-muted small px-3 mb-1">Admin</div>
                    <a class="nav-link @CurrentClass("Users") text-body" asp-controller="Users" asp-action="Index">
                        <span class="me-2">☻</span> Users
                    </a>
                    <a class="nav-link @CurrentClass("Audit") text-body" asp-controller="Audit" asp-action="Index">
                        <span class="me-2">∎</span> Audit log
                    </a>
                    <a class="nav-link @CurrentClass("Settings") text-body" asp-controller="Settings" asp-action="Index">
                        <span class="me-2">⚙</span> Settings
                    </a>
                </li>
            }
        </ul>
    </aside>
}
