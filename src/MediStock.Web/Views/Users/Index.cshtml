@model MediStock.Web.Models.InventoryListViewModel<MediStock.Application.Dtos.UserListItemDto>
@{
    ViewData["Title"] = "Users";
    ViewData["Page"] = Model.Page.Page;
    ViewData["TotalPages"] = Model.Page.TotalPages;
    ViewData["TotalCount"] = Model.Page.TotalCount;
    ViewData["Search"] = Model.Search;
    ViewData["Sort"] = Model.Sort;
    ViewData["Descending"] = Model.Descending;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Users</h1>
    <a class="btn btn-primary" asp-action="Create">+ New user</a>
</div>

<partial name="_Toasts" />

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Search by email, name, or phone…" />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary" type="submit">Search</button>
        @if (!string.IsNullOrEmpty(Model.Search))
        { <a class="btn btn-link" asp-action="Index">Clear</a> }
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th class="text-end" style="width:160px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Page.Items)
                {
                    <tr class="@(u.IsActive ? "" : "text-muted")">
                        <td>@u.FullName</td>
                        <td>@u.Email</td>
                        <td>@(u.Phone ?? "—")</td>
                        <td><span class="badge bg-info-subtle text-info">@u.Role</span></td>
                        <td>
                            @if (u.IsActive)
                            { <span class="badge bg-success-subtle text-success">Active</span> }
                            else
                            { <span class="badge bg-secondary-subtle text-secondary">Inactive</span> }
                        </td>
                        <td class="small text-muted">@u.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@u.Id">View</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@u.Id">Edit</a>
                        </td>
                    </tr>
                }
                @if (!Model.Page.Items.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No users yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pager" />
