@model MediStock.Web.Models.UserResetPasswordViewModel
@{ ViewData["Title"] = $"Reset password — {Model.Email}"; }

<h1 class="h4 mb-3">Reset password for @Model.Email</h1>

<div class="alert alert-warning">
    Setting a new password will sign the user out of every active session and is logged in the audit trail.
</div>

<form method="post" asp-action="ResetPassword" class="card shadow-sm">
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="Email" />
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label"></label>
            <input asp-for="NewPassword" class="form-control" type="password" autofocus />
            <small class="form-text text-muted">Min 8 characters with at least one digit, uppercase, lowercase, and non-alphanumeric.</small>
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="AdminPassword" class="form-label"></label>
            <input asp-for="AdminPassword" class="form-control" type="password" />
            <span asp-validation-for="AdminPassword" class="text-danger"></span>
        </div>
    </div>
    <div class="card-footer text-end">
        <a class="btn btn-link" asp-action="Details" asp-route-id="@Model.UserId">Cancel</a>
        <button type="submit" class="btn btn-warning">Reset password</button>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
